{
  "package": "com.vt.starry",
  "name": "Starry",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/icon.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.router"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.device"
    },
    {
      "name": "system.interconnect"
    },
    {
      "name": "system.file"
    },
    {
      "name": "system.brightness"
    },
    {
      "name": "system.app"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": "device-width"
  },
  "display": {
    "orientation": "portrait"
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      },
      "pages/detail": {
        "component": "detail"
      },
      "pages/volume": {
        "component": "volume"
      },
      "pages/settings": {
        "component": "settings"
      },
      "pages/interface": {
        "component": "interface"
      },
      "pages/landscape": {
        "component": "landscape"
      },
      "pages/landscape-volume": {
        "component": "landscape-volume"
      },
      "pages/theme": {
        "component": "theme"
      },
      "pages/theme-background": {
        "component": "theme-background"
      },
      "pages/lyrics-settings": {
        "component": "lyrics-settings"
      },
      "pages/debug": {
        "component": "debug"
      },
      "pages/about": {
        "component": "about"
      },
      "pages/blurprobe": {
        "component": "blurprobe"
      }
    }
  }
}
