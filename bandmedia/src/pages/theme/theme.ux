<template>
  <div class="theme-page">
    <div class="top-bar">
      <div class="back-button" onclick="back"><image class="back-icon" src="/common/back.png"></image></div>
      <text class="page-title">主题</text>
      <text class="clock">{{clock}}</text>
    </div>
    <div class="theme-list">
      <div class="theme-row" onclick="selectCover"><image class="theme-icon" src="/common/theme-cover.png"></image><text class="theme-text">封面</text><div if="{{theme === 'cover'}}" class="selected-dot"></div></div>
      <div class="theme-row" onclick="selectDay"><image class="theme-icon" src="/common/theme-day.png"></image><text class="theme-text">白日</text><div if="{{theme === 'day'}}" class="selected-dot"></div></div>
      <div class="theme-row" onclick="selectNight"><image class="theme-icon" src="/common/theme-night.png"></image><text class="theme-text">黑夜</text><div if="{{theme === 'night'}}" class="selected-dot"></div></div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"

const THEME_KEY = "bandmedia_theme_v1"

export default {
  private: { clock: "--:--", theme: "night" },
  onInit() {
    this.refreshClock()
    this.loadTheme()
    this.timer = setInterval(() => this.refreshClock(), 1000)
  },
  onDestroy() { if (this.timer) clearInterval(this.timer) },
  refreshClock() {
    const d = new Date()
    this.clock = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2)
  },
  loadTheme() {
    storage.get({ key: THEME_KEY, success: value => { if (value === "cover" || value === "day" || value === "night") this.theme = value } })
  },
  saveTheme(value) {
    this.theme = value
    storage.set({ key: THEME_KEY, value })
  },
  selectCover() { this.saveTheme("cover") },
  selectDay() { this.saveTheme("day") },
  selectNight() { this.saveTheme("night") },
  back() { router.back() }
}
</script>

<style>
text,input{font-family:MiSans,sans-serif}
.theme-page{width:336px;height:480px;position:relative;background-color:#000;border-radius:48px;overflow:hidden}
.top-bar{position:absolute;left:0;top:0;width:336px;height:78px;background-color:#000}
.back-button{position:absolute;left:8px;top:8px;width:68px;height:62px;align-items:center;justify-content:center}
.back-icon{width:40px;height:40px}
.page-title{position:absolute;left:118px;top:29px;width:100px;color:#fff;font-size:30px;font-weight:500;line-height:38px;text-align:center}
.clock{position:absolute;right:36px;top:30px;width:58px;color:#f2f2f2;font-size:17px;font-weight:500;line-height:22px;text-align:right}
.theme-list{position:absolute;left:0;top:78px;width:336px;height:402px;flex-direction:column;align-items:center}
.theme-row{position:relative;width:304px;height:88px;margin-top:12px;border-radius:34px;background-color:#303030;align-items:center}
.theme-icon{width:60px;height:60px;margin-left:13px}
.theme-text{margin-left:10px;color:#fff;font-size:29px;font-weight:400;line-height:38px;lines:1}
.selected-dot{position:absolute;right:36px;width:20px;height:20px;border-radius:10px;background-color:#719ff0}
</style>
