<template>
  <div class="portrait-viewport">
  <div class="{{theme === 'day' ? 'landscape-page landscape-day' : 'landscape-page'}}">
    <image if="{{theme === 'cover' && connected && albumArt}}" class="landscape-background-base" src="{{albumArt}}"></image>
    <image if="{{theme === 'cover' && connected && albumArt}}" class="landscape-background-blur" src="{{albumArt}}" style="filter:blur({{coverBlurPx}}px)"></image>
    <div if="{{theme === 'cover' && connected && albumArt}}" class="landscape-background-tint" style="opacity:{{coverOverlayOpacity}}"></div>
    <div class="{{theme === 'day' ? 'landscape-cover-shell landscape-cover-shell-day' : 'landscape-cover-shell'}}" onclick="routeLyrics">
      <image if="{{albumArt}}" class="landscape-cover" src="{{albumArt}}"></image>
      <div if="{{!albumArt}}" class="landscape-cover-empty"><text class="landscape-cover-note">♪</text></div>
    </div>
    <div class="landscape-metadata" onclick="routeLyrics"><text class="{{theme === 'day' ? 'landscape-song-day' : 'landscape-song'}}">{{song}}</text><text class="{{theme === 'day' ? 'landscape-artist-day' : 'landscape-artist'}}">{{artist}}</text></div>
    <text class="{{theme === 'day' ? 'landscape-clock-day' : 'landscape-clock'}}">{{clock}}</text>
    <div class="landscape-lyrics"><text class="{{theme === 'day' ? 'landscape-previous-day' : 'landscape-previous'}}" style="font-size:{{mutedLyricFontSize}}px">{{previousLyric}}</text><text class="{{theme === 'day' ? 'landscape-active-day' : 'landscape-active'}}" style="font-size:{{lyricFontSize}}px">{{activeLyric}}</text><text class="{{theme === 'day' ? 'landscape-next-day' : 'landscape-next'}}" style="font-size:{{mutedLyricFontSize}}px">{{nextLyric}}</text></div>
    <text if="{{!connected}}" class="landscape-disconnected">{{connectionState}}</text>
    <div class="landscape-progress-row"><text class="{{theme === 'day' ? 'landscape-time-day-left' : 'landscape-time-left'}}">{{elapsed}}</text><div class="landscape-slider"><div class="{{theme === 'day' ? 'landscape-track-day' : 'landscape-track'}}"><div if="{{hasProgress}}" class="{{theme === 'day' ? 'landscape-fill-day' : 'landscape-fill'}}" style="width:{{progressWidth}}px"></div></div><div if="{{hasProgress}}" class="{{theme === 'day' ? 'landscape-knob-day' : 'landscape-knob'}}" style="left:{{progressKnobLeft}}px"></div></div><text class="{{theme === 'day' ? 'landscape-time-day-right' : 'landscape-time-right'}}">{{remaining}}</text></div>
    <div class="landscape-controls">
      <div class="landscape-control" onclick="routeSettings"><image class="landscape-settings" src="{{theme === 'day' ? '/common/setting-day.png' : '/common/setting.png'}}"></image></div>
      <div class="landscape-control" onclick="previous"><image class="landscape-previous-icon" src="{{theme === 'day' ? '/common/previous-day.png' : '/common/previous.png'}}"></image></div>
      <div class="landscape-play" onclick="togglePlayback"><image if="{{!playing && theme !== 'day'}}" class="landscape-play-image" src="/common/play.png"></image><div if="{{!playing && theme === 'day'}}" class="landscape-play-day"><div class="landscape-play-day-triangle"></div></div><div if="{{playing && theme !== 'day'}}" class="landscape-pause-night-code"><div class="landscape-pause-bar-night-code"></div><div class="landscape-pause-bar-night-code"></div></div><div if="{{playing && theme === 'day'}}" class="landscape-pause-day-code"><div class="landscape-pause-bar-day-code"></div><div class="landscape-pause-bar-day-code"></div></div></div>
      <div class="landscape-control" onclick="next"><image class="landscape-next-icon" src="{{theme === 'day' ? '/common/next-day.png' : '/common/next.png'}}"></image></div>
      <div class="landscape-control" onclick="routeVolume"><image class="landscape-volume-icon" src="{{theme === 'day' ? '/common/volume-day.png' : '/common/volume.png'}}"></image></div>
    </div>
  </div>
  </div>
</template>
<script>
import router from "@system.router"
import { readMediaState, normalizeMediaState, sendControlCommand } from "../../common/media-sync.js"
import { readDebugMode } from "../../common/debug.js"
import { readTheme, readCoverBackground } from "../../common/theme.js"
import { readLyricsFontSize } from "../../common/lyrics.js"
import { readInterfaceOrientation } from "../../common/interface.js"
import { replacePage } from "../../common/navigation.js"

export default {
  private: { song: "等待同步", artist: "Android 同步器", albumArt: "", clock: "--:--", previousLyric: "", activeLyric: "等待 Android 同步器提供歌词", nextLyric: "", lyricFontSize: 20, mutedLyricFontSize: 17, elapsed: "00:00", remaining: "--:--", progressWidth: 0, progressKnobLeft: 0, hasProgress: false, playing: false, connected: false, connectionState: "检测中", debugMode: false, theme: "night", coverBlurPx: 24, coverOverlayOpacity: 0.2 },
  onInit() { this.refreshClock(); this.loadTheme(); this.loadLyricsSettings(); readDebugMode(enabled => { this.debugMode = enabled; this.load() }); this.timer = setInterval(() => { this.refreshClock(); this.load() }, 100) },
  onShow() { this.syncOrientation(); this.loadTheme(); this.loadLyricsSettings() },
  onRefresh() { this.syncOrientation(); this.loadTheme(); this.loadLyricsSettings() },
  onDestroy() { if (this.timer) clearInterval(this.timer) },
  refreshClock() { const d = new Date(); this.clock = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2) },
  loadTheme() { readTheme(theme => { this.theme = theme }); readCoverBackground(value => { this.coverBlurPx = Math.round(value.blur * 24 / 100); this.coverOverlayOpacity = value.overlay / 100 }) },
  syncOrientation() { readInterfaceOrientation(value => { if (value !== "landscape") router.push({ uri: "/pages/index", params: { ___PARAM_LAUNCH_FLAG___: "clearTask" } }) }) },
  loadLyricsSettings() { readLyricsFontSize(value => { this.lyricFontSize = value; this.mutedLyricFontSize = Math.max(12, value - 3) }) },
  load() { if (this.debugMode) { this.applyDebug(); return } const realtime = this.$app.$def.getRealtimeMediaState(); if (realtime && realtime.state) { this.applyMedia(normalizeMediaState(realtime.state, realtime.connected)); return } readMediaState(media => this.applyMedia(media), () => { this.connected = false; this.connectionState = "未连接" }) },
  applyDebug() { this.song = "五月猫"; this.artist = "ナナツカゼ"; this.albumArt = "/common/debugmusic-icon.png"; this.previousLyric = "何度思っただろう"; this.activeLyric = "もし世界中の人が夢を諦めたら  誰の心にも穴が空かず済むだろう"; this.nextLyric = "再生"; this.elapsed = "02:06"; this.remaining = "04:45"; this.progressWidth = Math.round(309 * 126 / 285); this.progressKnobLeft = Math.round(292 * 126 / 285); this.hasProgress = true; this.playing = false; this.connected = true; this.connectionState = "已连接" },
  applyMedia(media) { const lines = media.lyrics.map(line => typeof line === "string" ? line : line.text).filter(line => !!line); const index = Math.max(0, Math.min(lines.length - 1, media.activeLyricIndex)); this.song = media.title; this.artist = media.artist; this.albumArt = media.albumArt; this.previousLyric = index > 0 ? lines[index - 1] : ""; this.activeLyric = lines.length ? lines[index] : "等待 Android 同步器提供歌词"; this.nextLyric = index + 1 < lines.length ? lines[index + 1] : ""; this.elapsed = media.elapsed; this.remaining = media.remaining; this.progressWidth = Math.round(media.progressWidth * 309 / 198); this.progressKnobLeft = Math.round(media.progressKnobLeft * 292 / 181); this.hasProgress = media.hasProgress; this.playing = media.playing; this.connected = media.connectionState === "已连接"; this.connectionState = media.connectionState },
  routeLyrics() { replacePage("/pages/detail", { theme: this.theme }) }, routeSettings() { replacePage("/pages/settings") }, routeVolume() { replacePage("/pages/landscape-volume") }, exitApp() { router.back() }, togglePlayback() { sendControlCommand(this.playing ? "pause" : "play") }, previous() { sendControlCommand("previous") }, next() { sendControlCommand("next") }
}
</script>
<style>
text,input{font-family:MiSans,sans-serif}.landscape-page{width:480px;height:336px;position:relative;background-color:#242424;border-radius:48px;overflow:hidden}.landscape-back{position:absolute;left:29px;top:266px;width:48px;height:54px;align-items:center;justify-content:center}.landscape-back-icon{width:40px;height:40px;opacity:.6}.landscape-cover-shell{position:absolute;left:31px;top:34px;width:66px;height:66px;border-radius:33px;border-width:3px;border-color:#777;background-color:#303030;overflow:hidden;align-items:center;justify-content:center}.landscape-cover{width:60px;height:60px;border-radius:30px}.landscape-cover-empty{width:60px;height:60px;border-radius:30px;background-color:#266a9c;align-items:center;justify-content:center}.landscape-cover-note{color:#b9ddf5;font-size:30px}.landscape-metadata{position:absolute;left:109px;top:34px;width:188px;height:50px;flex-direction:column}.landscape-song{width:188px;color:#fff;font-size:21px;font-weight:500;line-height:26px;lines:1;text-overflow:ellipsis}.landscape-artist{width:188px;margin-top:2px;color:#999;font-size:13px;line-height:18px;lines:1;text-overflow:ellipsis}.landscape-clock{position:absolute;right:36px;top:15px;width:58px;color:#eee;font-size:20px;font-weight:500;text-align:right;line-height:24px}.landscape-lyrics{position:absolute;left:60px;top:86px;width:360px;height:142px}.landscape-previous,.landscape-active,.landscape-next{position:absolute;left:0;width:360px;text-align:center}.landscape-previous{top:0;color:#666;font-size:20px;line-height:26px}.landscape-active{top:46px;color:#fff;font-size:20px;line-height:25px}.landscape-next{top:118px;color:#666;font-size:20px;line-height:26px}.landscape-disconnected{position:absolute;left:90px;top:139px;width:300px;color:#fff;font-size:21px;text-align:center}.landscape-progress-row{position:absolute;left:34px;top:228px;width:412px;height:26px;align-items:center}.landscape-time{width:52px;color:#fff;font-size:14px;line-height:22px}.landscape-remaining{text-align:right}.landscape-slider{position:relative;width:309px;height:17px}.landscape-track{position:absolute;left:0;top:6px;width:309px;height:5px;border-radius:3px;background-color:#586d7c}.landscape-fill{height:5px;border-radius:3px;background-color:#70b6e8}.landscape-knob{position:absolute;top:0;width:17px;height:17px;border-radius:9px;border-width:2px;border-color:#fff;background-color:#70b6e8}.landscape-controls{position:absolute;left:43px;top:266px;width:394px;height:62px;align-items:center;justify-content:space-between}.landscape-control{width:48px;height:54px;align-items:center;justify-content:center}.landscape-settings{width:23px;height:23px}.landscape-previous-icon{width:20px;height:24px}.landscape-next-icon{width:20px;height:22px}.landscape-volume-icon{width:20px;height:20px}.landscape-play,.landscape-play-image,.landscape-pause{width:62px;height:62px}.landscape-play{align-items:center;justify-content:center}.landscape-pause{border-radius:31px;border-width:2px;border-color:#fff;align-items:center;justify-content:center}.landscape-pause-bar{width:7px;height:27px;margin-left:4px;margin-right:4px;border-radius:3px;background-color:#fff}
.landscape-background-base{position:absolute;left:0;top:0;width:480px;height:336px}
.landscape-background-blur{position:absolute;left:-72px;top:-50px;width:624px;height:436px}
.landscape-background-tint{position:absolute;left:0;top:0;width:480px;height:336px;background-color:#000}
.portrait-viewport{width:336px;height:480px;position:relative;background-color:#000;overflow:hidden}
.landscape-page{position:absolute;left:336px;top:0;width:480px;height:336px;transform:rotate(90deg);transform-origin:left top}
.landscape-metadata{width:250px}
.landscape-song{width:250px}
.landscape-artist{width:250px}
.landscape-previous{top:0}
.landscape-active{top:46px}
.landscape-next{top:114px}
.landscape-day{background-color:#fff}
.landscape-cover-shell-day{border-color:#d0d0d0;background-color:#eee}
.landscape-song-day{width:250px;color:#444;font-size:21px;font-weight:500;line-height:26px;lines:1;text-overflow:ellipsis}.landscape-artist-day{width:250px;margin-top:2px;color:#999;font-size:13px;line-height:18px;lines:1;text-overflow:ellipsis}.landscape-clock-day{position:absolute;right:36px;top:15px;width:58px;color:#555;font-size:20px;font-weight:500;text-align:right;line-height:24px}.landscape-previous-day,.landscape-active-day,.landscape-next-day{position:absolute;left:0;width:360px;text-align:center}.landscape-previous-day{top:0;color:#bbb;font-size:20px;line-height:26px}.landscape-active-day{top:46px;color:#444;font-size:20px;line-height:25px}.landscape-next-day{top:114px;color:#bbb;font-size:20px;line-height:26px}
.landscape-time-left,.landscape-time-right,.landscape-time-day-left,.landscape-time-day-right{width:52px;font-size:14px;line-height:22px}.landscape-time-left,.landscape-time-right{color:#fff}.landscape-time-day-left,.landscape-time-day-right{color:#555}.landscape-time-right,.landscape-time-day-right{text-align:right}.landscape-track-day{position:absolute;left:0;top:6px;width:309px;height:5px;border-radius:3px;background-color:#d8e5ee}.landscape-fill-day{height:5px;border-radius:3px;background-color:#70b6e8}.landscape-knob-day{position:absolute;top:0;width:17px;height:17px;border-radius:9px;border-width:2px;border-color:#fff;background-color:#70b6e8}
.landscape-play-day{position:relative;width:62px;height:62px;border-radius:31px;border-width:2px;border-style:solid;border-color:#555;align-items:center;justify-content:center}.landscape-play-day-triangle{width:0;height:0;margin-left:5px;border-top-width:12px;border-bottom-width:12px;border-left-width:19px;border-top-color:transparent;border-bottom-color:transparent;border-left-color:#555;border-style:solid}.landscape-pause-night-code,.landscape-pause-day-code{width:62px;height:62px;border-radius:31px;border-width:2px;border-style:solid;align-items:center;justify-content:center}.landscape-pause-night-code{border-color:#fff}.landscape-pause-day-code{border-color:#555}.landscape-pause-bar-night-code,.landscape-pause-bar-day-code{width:7px;height:27px;margin-left:4px;margin-right:4px;border-radius:3px}.landscape-pause-bar-night-code{background-color:#fff}.landscape-pause-bar-day-code{background-color:#555}
</style>
