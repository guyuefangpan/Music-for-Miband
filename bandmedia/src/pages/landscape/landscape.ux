.landscape-song-day{width:250px;color:#444;font-size:21px;font-weight:500;line-height:26px;lines:1;text-overflow:ellipsis}.landscape-artist-day{width:250px;margin-top:2px;color:#999;font-size:13px;line-height:18px;lines:1;text-overflow:ellipsis}.landscape-clock-day{position:absolute;right:36px;top:15px;width:58px;color:#555;font-size:20px;font-weight:500;text-align:right;line-height:24px}.landscape-previous-day,.landscape-active-day,.landscape-next-day{position:absolute;left:0;width:360px;text-align:center}.landscape-previous-day{top:0;color:#bbb;font-size:20px;line-height:26px}.landscape-active-day{top:46px;color:#444;font-size:20px;line-height:25px}.landscape-next-day{top:114px;color:#bbb;font-size:20px;line-height:26px}
.landscape-time-left,.landscape-time-right,.landscape-time-day-left,.landscape-time-day-right{width:52px;font-size:14px;line-height:22px}.landscape-time-left,.landscape-time-right{color:#fff}.landscape-time-day-left,.landscape-time-day-right{color:#555}.landscape-time-right,.landscape-time-day-right{text-align:right}.landscape-track-day{position:absolute;left:0;top:6px;width:309px;height:5px;border-radius:3px;background-color:#d8e5ee}.landscape-fill-day{height:5px;border-radius:3px;background-color:#70b6e8}.landscape-knob-day{position:absolute;top:0;width:17px;height:17px;border-radius:9px;border-width:2px;border-color:#fff;background-color:#70b6e8}
.landscape-play-day{position:relative;width:62px;height:62px;border-radius:31px;border-width:2px;border-style:solid;border-color:#555;align-items:center;justify-content:center}.landscape-play-day-triangle{width:0;height:0;margin-left:5px;border-top-width:12px;border-bottom-width:12px;border-left-width:19px;border-top-color:transparent;border-bottom-color:transparent;border-left-color:#555;border-style:solid}.landscape-pause-night-code,.landscape-pause-day-code{width:62px;height:62px;border-radius:31px;border-width:2px;border-style:solid;align-items:center;justify-content:center}.landscape-pause-night-code{border-color:#fff}.landscape-pause-day-code{border-color:#555}.landscape-pause-bar-night-code,.landscape-pause-bar-day-code{width:7px;height:27px;margin-left:4px;margin-right:4px;border-radius:3px}.landscape-pause-bar-night-code{background-color:#fff}.landscape-pause-bar-day-code{background-color:#555}
</style>
