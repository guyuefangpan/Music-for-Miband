<template>
  <div class="settings-page">
    <text class="clock">{{clock}}</text>
    <text class="page-title">设置</text>
    <div class="setting-row" onclick="refreshConnection"><div class="status-dot"></div><text class="row-text">连接状态:{{connectionState}}</text></div>
    <div class="setting-row"><div class="status-dot"></div><text class="row-text">主题:深色</text></div>
    <div class="setting-row"><div class="status-dot"></div><text class="row-text">屏幕方向:竖</text></div>
    <div class="setting-row" onclick="routeAbout"><div class="status-dot"></div><text class="row-text">关于</text></div>
    <div class="back-button" onclick="back"><image class="back-icon" src="/common/back.png"></image></div>
  </div>
</template>
<script>
import router from "@system.router"
import { readMediaState } from "../../common/media-sync.js"
export default {
  private: { clock: "--:--", connectionState: "检测中" },
  onInit() { this.refreshClock(); this.refreshConnection(); this.timer = setInterval(() => { this.refreshClock(); this.refreshConnection() }, 1000) },
  onDestroy() { if (this.timer) clearInterval(this.timer) },
  refreshClock() { const d = new Date(); this.clock = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2) },
  refreshConnection() { readMediaState(m => { this.connectionState = m.connectionState }, () => { this.connectionState = "未连接" }) },
  routeAbout() { router.push({ uri: "/pages/about" }) },
  back() { router.back() }
}
</script>
<style>
text,input{font-family:MiSans,sans-serif}.settings-page{width:336px;height:480px;position:relative;background-color:#000;border-radius:48px;flex-direction:column;align-items:center}.page-title{margin-top:31px;color:#fff;font-size:30px;font-weight:500;line-height:36px}.clock{position:absolute;right:36px;top:30px;width:58px;color:#f2f2f2;font-size:17px;text-align:right;line-height:22px}.setting-row{width:304px;height:88px;margin-top:12px;border-radius:28px;background-color:#303030;align-items:center}.status-dot{width:60px;height:60px;margin-left:13px;border-radius:30px;background-color:#7195b8}.row-text{margin-left:10px;color:#fff;font-size:27px;font-weight:400;line-height:34px;lines:1;text-overflow:ellipsis}.back-button{position:absolute;left:8px;top:8px;width:58px;height:54px;align-items:center;justify-content:center}.back-icon{width:40px;height:40px}
</style>
