<template>
  <div class="settings-page">
    <div class="top-bar">
      <div class="back-button" onclick="back"><image class="back-icon" src="/common/back.png"></image></div>
      <text class="page-title">设置</text>
      <text class="clock">{{clock}}</text>
    </div>
    <scroll class="settings-scroll" scroll-y="true">
      <div class="settings-content">
        <div class="top-space"></div>
        <div class="setting-slot"><div class="exit-card" onclick="exitApp"><div class="exit-icon"><div class="exit-ring"></div><div class="exit-line"></div></div><text class="row-text">退出应用</text></div></div>
        <div class="setting-slot"><div class="interface-card" onclick="routeInterface"><image class="setting-icon" src="/common/settings-interface.png"></image><text class="row-text">界面</text></div></div>
        <div class="setting-slot"><div class="theme-card" onclick="routeTheme"><image class="setting-icon" src="/common/settings-theme.png"></image><text class="row-text">主题</text></div></div>
        <div class="setting-slot"><div class="lyrics-card" onclick="routeLyrics"><image class="setting-icon" src="/common/settings-lyrics.png"></image><text class="row-text">歌词</text></div></div>
        <div class="setting-slot"><div class="about-card" onclick="routeAbout"><image class="setting-icon" src="/common/settings-about.png"></image><text class="row-text">关于</text></div></div>
        <div class="bottom-space"></div>
      </div>
    </scroll>
  </div>
</template>
<script>
import app from "@system.app"
import { replacePage, openPlayerRoot } from "../../common/navigation.js"
export default {
  private: { clock: "--:--" },
  onInit() { this.refreshClock(); this.timer = setInterval(() => this.refreshClock(), 1000) },
  onDestroy() { if (this.timer) clearInterval(this.timer) },
  refreshClock() { const d = new Date(); this.clock = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2) },
  routeInterface() { replacePage("/pages/interface") },
  routeTheme() { replacePage("/pages/theme") },
  routeLyrics() { replacePage("/pages/lyrics-settings") },
  routeAbout() { replacePage("/pages/about") },
  exitApp() { app.terminate() },
  back() { openPlayerRoot() }
}
</script>
<style>
text,input{font-family:MiSans,sans-serif}
.settings-page{width:336px;height:480px;position:relative;background-color:#000;border-radius:48px;overflow:hidden}
.top-bar{position:absolute;left:0;top:0;width:336px;height:78px;background-color:#000}
.back-button{position:absolute;left:8px;top:8px;width:68px;height:62px;align-items:center;justify-content:center}
.back-icon{width:40px;height:40px}
