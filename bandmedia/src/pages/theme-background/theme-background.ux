<template>
  <div class="{{isRing10 ? 'ring-background-page' : 'background-page'}}">
    <div class="{{isRing10 ? 'ring-background-top' : 'top-bar'}}"><text class="{{isRing10 ? 'ring-background-title' : 'page-title'}}" onclick="back">主题</text><text class="{{isRing10 ? 'ring-background-clock' : 'clock'}}">{{clock}}</text></div>
    <scroll class="{{isRing10 ? 'ring-background-scroll' : 'settings-scroll'}}" scroll-y="true">
      <div class="{{isRing10 ? 'ring-background-content' : 'settings-content'}}">
        <div class="{{isRing10 ? 'ring-background-card' : 'settings-card'}}">
          <text class="setting-title overlay-title">遮罩不透明度</text>
          <text class="setting-note overlay-note">调整歌词显示效果</text>
          <div class="minus overlay-minus" onclick="decreaseOverlay"><div class="minus-line"></div></div>
          <text class="{{isRing10 ? 'ring-overlay-value' : 'setting-value overlay-value'}}">{{overlay}}%</text>
          <div class="plus overlay-plus" onclick="increaseOverlay"><div class="plus-horizontal"></div><div class="plus-vertical"></div></div>
          <text class="setting-title blur-title">背景模糊</text>
          <text class="setting-note blur-note">减少背景细节</text>
          <div class="minus blur-minus" onclick="decreaseBlur"><div class="minus-line"></div></div>
          <text class="{{isRing10 ? 'ring-blur-value' : 'setting-value blur-value'}}">{{blur}}</text>
          <div class="plus blur-plus" onclick="increaseBlur"><div class="plus-horizontal"></div><div class="plus-vertical"></div></div>
          <div class="{{isRing10 ? 'ring-background-preview' : 'preview'}}">
            <image class="{{isRing10 ? 'ring-preview-base' : 'preview-base'}}" src="/common/debugmusic-icon.png"></image>
            <image class="{{isRing10 ? 'ring-preview-blur' : 'preview-blur'}}" src="/common/debugmusic-icon.png" style="filter:blur({{blurPx}}px)"></image>
            <div class="{{isRing10 ? 'ring-preview-overlay' : 'preview-overlay'}}" style="opacity:{{overlayOpacity}};background-color:#000"></div>
            <text class="{{isRing10 ? 'ring-preview-text' : 'preview-text'}}">永远相信美好的事情\n即将发生</text>
          </div>
        </div>
        <div class="bottom-space"></div>
      </div>
    </scroll>
  </div>
</template>
<script>
import { readCoverBackground, writeCoverOverlay, writeCoverBlur } from "../../common/theme.js"
import { replacePage } from "../../common/navigation.js"
import { readIsRing10 } from "../../common/device.js"
export default {
  private: { clock: "--:--", overlay: 20, blur: 100, overlayOpacity: 0.2, blurPx: 24, isRing10: false },
  onInit() { this.refreshClock(); readIsRing10(value => { this.isRing10 = value }); this.load(); this.timer = setInterval(() => this.refreshClock(), 1000) },
  onShow() { this.load() },
  onDestroy() { if (this.timer) clearInterval(this.timer) },
  refreshClock() { const d = new Date(); this.clock = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2) },
  load() { readCoverBackground(value => { this.overlay = value.overlay; this.blur = value.blur; this.updatePreview() }) },
  updatePreview() { this.overlayOpacity = this.overlay / 100; this.blurPx = Math.round(this.blur * 24 / 100) },
  setOverlay(value) { this.overlay = Math.max(0, Math.min(100, value)); this.updatePreview(); writeCoverOverlay(this.overlay) },
  setBlur(value) { this.blur = Math.max(0, Math.min(200, value)); this.updatePreview(); writeCoverBlur(this.blur) },
  decreaseOverlay() { this.setOverlay(this.overlay - 5) },
  increaseOverlay() { this.setOverlay(this.overlay + 5) },
  decreaseBlur() { this.setBlur(this.blur - 10) },
  increaseBlur() { this.setBlur(this.blur + 10) },
  back() { replacePage("/pages/theme") }
}
</script>
<style>
text,input{font-family:MiSans,sans-serif}.background-page{width:336px;height:480px;position:relative;background-color:#000;border-radius:48px;overflow:hidden}.top-bar{position:absolute;left:0;top:0;width:336px;height:78px;background-color:#000}.page-title{position:absolute;left:118px;top:29px;width:100px;color:#fff;font-size:30px;font-weight:500;line-height:38px;text-align:center}.clock{position:absolute;right:26px;top:13px;width:58px;color:#f2f2f2;font-size:20px;font-weight:500;line-height:24px;text-align:right}.settings-scroll{position:absolute;left:0;top:78px;width:336px;height:402px}.settings-content{width:336px;height:490px;align-items:center;flex-direction:column}.settings-card{position:relative;width:304px;height:456px;margin-top:11px;border-radius:34px;background-color:#303030;overflow:hidden}.setting-title,.setting-note,.setting-value{position:absolute;color:#fff}.setting-title{left:17px;width:270px;font-size:29px;line-height:39px}.setting-note{left:17px;width:270px;color:#999;font-size:18px;line-height:27px}.overlay-title{top:14px}.overlay-note{top:54px}.blur-title{top:148px}.blur-note{top:188px}.setting-value{left:105px;width:94px;font-size:30px;line-height:40px;text-align:center}.overlay-value{top:82px}.blur-value{top:216px}.minus,.plus{position:absolute;width:70px;height:60px;align-items:center;justify-content:center}.overlay-plus{left:10px;top:73px}.overlay-minus{right:10px;top:73px}.blur-plus{left:10px;top:207px}.blur-minus{right:10px;top:207px}.plus-horizontal,.minus-line{position:absolute;width:31px;height:5px;border-radius:3px;background-color:#fff}.plus-vertical{position:absolute;width:5px;height:31px;border-radius:3px;background-color:#fff}.preview{position:absolute;left:21px;top:295px;width:262px;height:149px;border-radius:21px;overflow:hidden;align-items:center;justify-content:center}.preview-base{position:absolute;left:0;top:0;width:262px;height:149px}.preview-blur{position:absolute;left:-36px;top:-24px;width:334px;height:197px}.preview-overlay{position:absolute;left:0;top:0;width:262px;height:149px;background-color:#000}.preview-text{position:absolute;left:20px;top:47px;width:222px;color:#fff;font-size:20px;line-height:27px;text-align:center;lines:2}.bottom-space{width:336px;height:23px}
</style>
<style>
.clock{font-size:20px;line-height:24px}.settings-card{width:316px}.preview-overlay{background-color:#000}
.ring-background-page{width:212px;height:520px;position:relative;background-color:#000;border-radius:106px;overflow:hidden}.ring-background-top{position:absolute;left:0;top:0;width:212px;height:80px;background-color:#000}.ring-background-title{position:absolute;left:56px;top:32px;width:100px;color:#fff;font-size:30px;line-height:38px;text-align:center}.ring-background-clock{position:absolute;right:52px;top:8px;width:108px;color:#f2f2f2;font-size:20px;line-height:24px;text-align:center}.ring-background-scroll{position:absolute;left:0;top:80px;width:212px;height:440px}.ring-background-content{width:212px;height:490px;align-items:center;flex-direction:column}.ring-background-card{position:relative;width:192px;height:422px;margin-top:9px;border-radius:34px;background-color:#303030;overflow:hidden;padding-left:17px;padding-right:15px}.ring-overlay-value,.ring-blur-value{position:absolute;left:50px;width:92px;color:#fff;font-size:30px;line-height:40px;text-align:center}.ring-overlay-value{top:82px}.ring-blur-value{top:216px}.ring-background-preview{position:absolute;left:17px;top:295px;width:158px;height:149px;border-radius:21px;overflow:hidden}.ring-preview-base{position:absolute;left:0;top:0;width:158px;height:149px}.ring-preview-blur{position:absolute;left:-30px;top:-24px;width:218px;height:180px}.ring-preview-overlay{position:absolute;left:0;top:0;width:158px;height:149px;background-color:#000}.ring-preview-text{position:absolute;left:8px;top:47px;width:142px;color:#fff;font-size:17px;line-height:25px;text-align:center;lines:2}
</style>
