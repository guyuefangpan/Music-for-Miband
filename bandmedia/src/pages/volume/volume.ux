<template>
  <div class="volume-page" onswipe="swipeBack">
    <div if="{{!isRing10}}" class="standard-volume">
      <text class="volume-label">音量</text>
      <input class="volume-button plus" type="button" value="+" onclick="increase" />
      <div class="volume-rail"><div class="volume-level" style="height:{{volumeHeight}}px"></div></div>
      <input class="volume-button minus" type="button" value="−" onclick="decrease" />
      <text class="volume-value">{{ volume }}%</text>
      <div class="back-button" onclick="back"><image class="back-icon" src="/common/back.png"></image></div>
    </div>
    <div if="{{isRing10}}" class="ring-volume-page">
      <input class="ring-volume-button ring-plus" type="button" value="+" onclick="increase" />
      <div class="ring-volume-rail"><div class="ring-volume-level" style="height:{{ringVolumeHeight}}px"></div></div>
      <input class="ring-volume-button ring-minus" type="button" value="−" onclick="decrease" />
      <text class="ring-volume-value">{{volume}}%</text>
      <div class="ring-close" onclick="back"><text class="ring-close-mark">×</text></div>
    </div>
  </div>
</template>
<script>
import { readIsRing10 } from "../../common/device.js"
import {readMediaState, sendControlCommand} from "../../common/media-sync.js"
import { backPage, backOnRightSwipe } from "../../common/navigation.js"
export default {
  private: {volume: 0, volumeHeight: 0, ringVolumeHeight: 0, isRing10: false, volumeReady: false},
  onInit() {
    this.detectDevice()
    this.load()
    this.timer = setInterval(() => this.load(), 1000)
  },
  detectDevice() {
    readIsRing10(value => { this.isRing10 = value })
  },
  onDestroy() {
    if (this.timer) clearInterval(this.timer)
  },
  load() {
    readMediaState(
      (m) => {
        if (!m.volumeValid) return
        this.volumeReady = true
        this.volume = m.volume
        this.volumeHeight = Math.round(m.volume * 2.45)
        this.ringVolumeHeight = Math.round(m.volume * 2.05)
      },
      () => {}
    )
  },
  increase() {
    if (!this.volumeReady) return
    sendControlCommand("volume_up")
  },
  decrease() {
    if (!this.volumeReady) return
    sendControlCommand("volume_down")
  },
  back() {
    backPage()
  },
  swipeBack(event) { backOnRightSwipe(event) }
}
</script>
<style>
text,
input {
  font-family: MiSans, sans-serif;
}
.volume-page {
  width: 100%;
  height: 100%;
  position: relative;
  background-color: #000;
  border-radius: 48px;
  flex-direction: column;
  align-items: center;
}
.standard-volume { width:336px; height:480px; position:relative; background-color:#000; border-radius:48px; flex-direction:column; align-items:center; }
.volume-label {
  color: #fff;
  font-size: 20px;
  font-weight: 500;
  margin-top: 27px;
  line-height: 24px;
}
.volume-button {
  width: 72px;
  height: 48px;
  border-radius: 24px;
  background-color: #303030;
  color: #fff;
  font-size: 34px;
  font-weight: 500;
  line-height: 44px;
  border-width: 0;
  text-align: center;
}
.plus {
  margin-top: 17px;
}
.minus {
  margin-top: 14px;
}
.volume-rail {
  width: 72px;
  height: 244px;
  margin-top: 14px;
  background-color: #303030;
  border-radius: 19px;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}
.volume-level {
  width: 72px;
  background-color: #fff;
  border-radius: 19px 19px 0 0;
}
.volume-value {
  position: absolute;
  bottom: 8px;
  color: #fff;
  font-size: 18px;
  font-weight: 500;
  text-align: center;
  width: 120px;
  line-height: 24px;
}
.back-button {
  position: absolute;
  left: 8px;
  top: 8px;
  width: 58px;
  height: 54px;
  align-items: center;
  justify-content: center;
}
.back-icon { width: 40px; height: 40px; }
.ring-volume-page { width:212px; height:520px; position:relative; background-color:#000; border-radius:106px; overflow:hidden; align-items:center; }
.ring-volume-button { position:absolute; left:75px; width:62px; height:47px; border-width:0; border-radius:24px; background-color:#303030; color:#fff; font-size:39px; line-height:43px; }
.ring-plus { top:70px; }
.ring-minus { top:346px; }
.ring-volume-rail { position:absolute; left:75px; top:127px; width:62px; height:205px; border-radius:16px; background-color:#303030; flex-direction:column; justify-content:flex-end; overflow:hidden; }
.ring-volume-level { width:62px; background-color:#fff; border-radius:16px 16px 0 0; }
.ring-volume-value { position:absolute; left:56px; top:399px; width:100px; color:#fff; font-size:17px; text-align:center; line-height:22px; }
.ring-close { position:absolute; left:76px; top:419px; width:60px; height:60px; align-items:center; justify-content:center; }
.ring-close-mark { color:#888; font-size:52px; font-weight:500; line-height:58px; }
</style>
