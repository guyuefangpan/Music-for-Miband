<template>
  <div class="{{isRing10 ? 'ring-about-page' : 'about-page'}}">
    <div class="{{isRing10 ? 'ring-about-top' : 'top-bar'}}">
      <text class="{{isRing10 ? 'ring-about-title' : 'page-title'}}" onclick="back">关于</text>
      <text class="{{isRing10 ? 'ring-about-clock' : 'clock'}}">{{clock}}</text>
    </div>

    <scroll class="{{isRing10 ? 'ring-about-scroll' : 'about-scroll'}}" scroll-y="true">
      <div class="{{isRing10 ? 'ring-about-content' : 'about-content'}}">
        <div class="{{isRing10 ? 'ring-product-card' : 'product-card'}}" onclick="openDebug">
          <text class="{{isRing10 ? 'ring-product-name' : 'product-name'}}">Starry</text>
          <text class="{{isRing10 ? 'ring-product-description' : 'product-description'}}">歌词显示器</text>
          <text if="{{!isRing10}}" class="product-version">ver1.0.0</text>
          <image class="brand-mark" src="/common/about-icon.png"></image>
        </div>

        <div class="{{isRing10 ? 'ring-qq-card' : 'qq-card'}}">
          <text class="qq-title">QQ交流群</text>
          <text class="qq-number">194377205</text>
        </div>

        <div class="{{isRing10 ? 'ring-credits-card' : 'credits-card'}}">
          <text class="credits-title">开发人员</text>
          <text class="credits-name">@洪淑森</text>
          <text class="credits-name">@IKUN_CXKPRO</text>
          <text class="credits-name">@木</text>
          <text class="credits-name">@山茶_skat</text>
        </div>
        <div class="bottom-space"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
import { replacePage } from "../../common/navigation.js"
import { readIsRing10 } from "../../common/device.js"

export default {
  private: {
    clock: "--:--",
    debugTapCount: 0, isRing10: false
  },
  onInit() {
    this.refreshClock()
    readIsRing10(value => { this.isRing10 = value })
    this.timer = setInterval(() => this.refreshClock(), 1000)
  },
  onDestroy() {
    if (this.timer) clearInterval(this.timer)
    if (this.debugTapTimer) clearTimeout(this.debugTapTimer)
  },
  refreshClock() {
    const date = new Date()
    this.clock = ("0" + date.getHours()).slice(-2) + ":" + ("0" + date.getMinutes()).slice(-2)
  },
  openDebug() {
    if (this.debugTapTimer) clearTimeout(this.debugTapTimer)
    this.debugTapCount++
    if (this.debugTapCount >= 20) {
      this.debugTapCount = 0
      this.debugTapTimer = null
      replacePage("/pages/debug")
      return
    }
    this.debugTapTimer = setTimeout(() => { this.debugTapCount = 0; this.debugTapTimer = null }, 5000)
  },
  back() {
    replacePage("/pages/settings")
  }
}
</script>

