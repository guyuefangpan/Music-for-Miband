<template>
  <div class="about-page">
    <text class="clock">{{clock}}</text>
    <text class="page-title">关于</text>
    <div class="version-card"><text class="product">BandMedia</text><text class="version">v0.0.1</text></div>
    <div class="credits"><text class="credits-title">参与开发的人员</text><text class="credits-name">@IKUN_CXKPRO</text></div>
    <div class="back-button" onclick="back"><image class="back-icon" src="/common/back.png"></image></div>
  </div>
</template>
<script>
import router from "@system.router"
export default {
  private: { clock: "--:--" },
  onInit() { this.refreshClock(); this.timer = setInterval(() => this.refreshClock(), 1000) },
  onDestroy() { if (this.timer) clearInterval(this.timer) },
  refreshClock() { const d = new Date(); this.clock = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2) },
  back() { router.back() }
}
</script>
<style>
text,input{font-family:MiSans,sans-serif}.about-page{width:336px;height:480px;position:relative;background-color:#000;border-radius:48px;flex-direction:column;align-items:center}.page-title{margin-top:31px;color:#fff;font-size:30px;font-weight:500;line-height:36px}.clock{position:absolute;right:36px;top:30px;width:58px;color:#f2f2f2;font-size:17px;text-align:right;line-height:22px}.version-card{width:304px;height:120px;margin-top:15px;border-radius:28px;background-color:#303030;flex-direction:column;align-items:center;justify-content:center}.product{color:#fff;font-size:31px;line-height:38px}.version{color:#fff;font-size:27px;line-height:34px}.credits{width:304px;margin-top:20px;flex-direction:column;align-items:flex-start}.credits-title,.credits-name{color:#fff;font-size:25px;line-height:34px}.credits-name{margin-top:5px}.back-button{position:absolute;left:8px;top:8px;width:58px;height:54px;align-items:center;justify-content:center}.back-icon{width:40px;height:40px}
</style>
