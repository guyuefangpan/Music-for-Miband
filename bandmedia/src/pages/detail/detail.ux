<template>
  <div class="{{theme === 'day' ? 'watch-page-day' : 'watch-page-night'}}">
    <image if="{{theme === 'cover' && albumArt && !isRing10}}" class="lyrics-background-base" src="{{albumArt}}"></image>
    <image if="{{theme === 'cover' && albumArt && !isRing10}}" class="lyrics-background-blur" src="{{albumArt}}" style="filter:blur({{coverBlurPx}}px)"></image>
    <div if="{{theme === 'cover' && albumArt && !isRing10}}" class="lyrics-background-tint" style="opacity:{{coverOverlayOpacity}}"></div>
    <div if="{{!isRing10}}" class="standard-lyrics">
      <div class="back-btn" onclick="routePlayer"><image class="back-icon" src="/common/back.png"></image></div>
      <div class="top"><text class="{{theme === 'day' ? 'song-day' : 'song-night'}}">{{song}}</text><text class="{{theme === 'day' ? 'artist-day' : 'artist-night'}}">{{artist}}</text></div>
      <text class="{{theme === 'day' ? 'time-day' : 'time-night'}}">{{clock}}</text>
      <div if="{{hasLyrics}}" class="lyrics-scroll">
        <div class="lyrics-list" style="top:{{lyricsListTop}}px">
          <text for="{{displayLyrics}}" class="{{$item.className}}" style="height:{{lyricRowHeight}}px;min-height:{{lyricRowHeight}}px;font-size:{{$item.fontSize}}px;line-height:{{lyricLineHeight}}px">{{$item.text}}</text>
        </div>
      </div>
      <text if="{{!hasLyrics}}" class="{{theme === 'day' ? 'empty-day' : 'empty-night'}}">等待 Android 同步器提供歌词</text>
      <div class="progress-row">
        <text class="{{theme === 'day' ? 'progress-time-day' : 'progress-time-night'}}">{{elapsed}}</text>
        <div class="progress-slider"><div class="{{theme === 'day' ? 'progress-track-day' : 'progress-track-night'}}"><div if="{{hasProgress}}" class="progress-fill" style="width:{{progressWidth}}px"></div></div><div if="{{hasProgress}}" class="{{theme === 'day' ? 'progress-knob-day' : 'progress-knob-night'}}" style="left:{{progressKnobLeft}}px"></div></div>
        <text class="{{theme === 'day' ? 'progress-time-day remaining' : 'progress-time-night remaining'}}">{{remaining}}</text>
      </div>
      <div class="control-row">
        <div class="control-small" onclick="routeSettings"><image class="settings-icon" src="{{theme === 'day' ? '/common/setting-day.png' : '/common/setting.png'}}"></image></div>
        <div class="control-small" onclick="previous"><image class="previous-icon" src="{{theme === 'day' ? '/common/previous-day.png' : '/common/previous.png'}}"></image></div>
        <div class="control-play" onclick="togglePlayback"><image if="{{!playing && theme !== 'day'}}" class="play-icon" src="/common/play.png"></image><div if="{{!playing && theme === 'day'}}" class="detail-play-day"><div class="detail-play-day-triangle"></div></div><div if="{{playing && theme !== 'day'}}" class="detail-pause-night"><div class="detail-pause-bar-night"></div><div class="detail-pause-bar-night"></div></div><div if="{{playing && theme === 'day'}}" class="detail-pause-day"><div class="detail-pause-bar-day"></div><div class="detail-pause-bar-day"></div></div></div>
        <div class="control-small" onclick="next"><image class="next-icon" src="{{theme === 'day' ? '/common/next-day.png' : '/common/next.png'}}"></image></div>
        <div class="control-small" onclick="routeVolume"><image class="volume-icon" src="{{theme === 'day' ? '/common/volume-day.png' : '/common/volume.png'}}"></image></div>
      </div>
    </div>
    <div if="{{isRing10}}" class="ring-lyrics-page">
      <div if="{{hasLyrics}}" class="ring-lyrics-scroll">
        <div class="ring-lyrics-list" style="top:{{ringLyricsListTop}}px"><text for="{{ringDisplayLyrics}}" class="{{$item.className}}" style="height:{{lyricRowHeight}}px;min-height:{{lyricRowHeight}}px;font-size:{{$item.fontSize}}px;line-height:{{lyricLineHeight}}px">{{$item.text}}</text></div>
      </div>
      <text if="{{!hasLyrics}}" class="ring-empty">等待 Android 同步器提供歌词</text>
      <div class="ring-back" onclick="routePlayer"><image class="ring-back-icon" src="/common/back.png"></image></div>
    </div>
  </div>
</template>
<script>
import device from "@system.device"
import { readMediaState, normalizeMediaState, sendControlCommand } from "../../common/media-sync.js"
import { readTheme, readCoverBackground } from "../../common/theme.js"
import { readDebugMode } from "../../common/debug.js"
import { readLyricsFontSize } from "../../common/lyrics.js"
import { replacePage, openPlayerRoot } from "../../common/navigation.js"
const DEBUG_PREVIOUS = ["もし地球が爆発したら", "皆ごと終わってしまえばって", "何度思っただろう"]
const DEBUG_ACTIVE = ["もし世界中の人が夢を諦めたら", "誰の心にも穴が空かず済むだろう"]
const DEBUG_NEXT = ["再生", "地球最後の日のミュージック"]
export default {
  protected: { theme: "night" },
  private: { song: "等待同步", artist: "Android 同步器", albumArt: "", clock: "--:--", isRing10: false, debugMode: false, displayLyrics: [], ringDisplayLyrics: [], activeIndex: -1, lyricsListTop: 106, ringLyricsListTop: 192, lyricFontSize: 20, mutedLyricFontSize: 17, lyricRowHeight: 46, lyricLineHeight: 23, hasLyrics: false, elapsed: "00:00", remaining: "--:--", progressWidth: 0, progressKnobLeft: 0, hasProgress: false, playing: false, coverBlurPx: 24, coverOverlayOpacity: 0.2 },
  onInit() { this.detectDevice(); this.refreshClock(); this.loadTheme(); this.loadLyricsSettings(); readDebugMode(enabled => { this.debugMode = enabled; this.refreshData() }); this.timer = setInterval(() => { this.refreshClock(); this.refreshData() }, 50) },
  onShow() { this.loadTheme(); this.loadLyricsSettings() },
  onDestroy() { if (this.timer) clearInterval(this.timer) },
  refreshClock() { const d = new Date(); this.clock = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2) },
  loadTheme() { readTheme(theme => { this.theme = theme }); readCoverBackground(value => { this.coverBlurPx = Math.round(value.blur * 24 / 100); this.coverOverlayOpacity = value.overlay / 100 }) },
  loadLyricsSettings() { readLyricsFontSize(value => { if (value === this.lyricFontSize) return; this.lyricFontSize = value; this.mutedLyricFontSize = Math.max(12, value - 3); this.lyricLineHeight = Math.max(20, value + 3); this.lyricRowHeight = Math.max(42, this.lyricLineHeight * 2); this.lastLyricsSignature = ""; this.activeIndex = -1; this.refreshData() }) },
  refreshData() { if (this.debugMode) this.applyDebugData(); else this.loadSyncData() },
  detectDevice() { device.getInfo({ success: info => { const width = info.screenWidth || info.width || info.windowWidth; const height = info.screenHeight || info.height || info.windowHeight; this.isRing10 = Number(width) === 212 && Number(height) === 520 }, fail: () => {}, complete: () => {} }) },
  applyDebugData() { this.song = "五月猫"; this.artist = "ナナツカゼ"; this.albumArt = "/common/debugmusic-icon.png"; this.applyLyrics(DEBUG_PREVIOUS.concat(DEBUG_ACTIVE).concat(DEBUG_NEXT), 3); this.elapsed = "02:06"; this.remaining = "04:45"; this.progressWidth = Math.round(209 * 126 / 285); this.progressKnobLeft = Math.round(193 * 126 / 285); this.hasProgress = true; this.playing = false },
  loadSyncData() { const realtime = this.$app.$def.getRealtimeMediaState(); if (realtime && realtime.state) { this.applyMediaState(normalizeMediaState(realtime.state, realtime.connected)); return } readMediaState(m => this.applyMediaState(m), () => { this.hasLyrics = false; this.displayLyrics = []; this.ringDisplayLyrics = []; this.elapsed = "00:00"; this.remaining = "--:--"; this.hasProgress = false }) },
  applyMediaState(m) { let lines = m.lyrics.map(line => typeof line === "string" ? line : line.text).filter(line => !!line); let activeIndex = lines.length ? Math.max(0, Math.min(lines.length - 1, m.activeLyricIndex)) : -1; if (!lines.length && m.activeLyric) { lines = [m.activeLyric]; activeIndex = 0 } this.song = m.title; this.artist = m.artist; this.albumArt = m.albumArt; this.applyLyrics(lines, activeIndex); this.elapsed = m.elapsed; this.remaining = m.remaining; this.progressWidth = Math.round(m.progressWidth * 209 / 198); this.progressKnobLeft = Math.round(m.progressKnobLeft * 193 / 181); this.hasProgress = m.hasProgress; this.playing = m.playing },
  applyLyrics(lines, activeIndex) {
    const signature = lines.join("\n")
    if (signature === this.lastLyricsSignature && activeIndex === this.activeIndex && this.theme === this.lastLyricsTheme) return
    const standard = []; const ring = []
    for (let i = 0; i < lines.length; i++) {
      standard.push({ text: lines[i], fontSize: i === activeIndex ? this.lyricFontSize : this.mutedLyricFontSize, className: i === activeIndex ? (this.theme === "day" ? "lyric-row-active-day" : "lyric-row-active-night") : (this.theme === "day" ? "lyric-row-muted-day" : "lyric-row-muted-night") })
      ring.push({ text: lines[i], fontSize: i === activeIndex ? this.lyricFontSize : this.mutedLyricFontSize, className: i === activeIndex ? "ring-row-active" : "ring-row-muted" })
    }
    this.displayLyrics = standard; this.ringDisplayLyrics = ring; this.hasLyrics = lines.length > 0
    if (activeIndex !== this.activeIndex) {
      // Vela does not reliably apply scroll-top after the first render. Move
      // the whole fixed-height list inside a clipped viewport instead.
      this.lyricsListTop = 106 - activeIndex * this.lyricRowHeight
      this.ringLyricsListTop = 192 - activeIndex * this.lyricRowHeight
    }
    this.lastLyricsSignature = signature
    this.lastLyricsTheme = this.theme
    this.activeIndex = activeIndex
  },
  routePlayer() { openPlayerRoot() }, routeSettings() { replacePage("/pages/settings") }, routeVolume() { replacePage("/pages/volume") },
  togglePlayback() { sendControlCommand(this.playing ? "pause" : "play") }, previous() { sendControlCommand("previous") }, next() { sendControlCommand("next") }
}
</script>
<style>
text,input{font-family:MiSans,sans-serif}.watch-page-night,.watch-page-day{width:100%;height:100%;position:relative;overflow:hidden}.watch-page-night{background-color:#242424}.watch-page-day{background-color:#fff}.standard-lyrics{width:336px;height:480px;position:relative;overflow:hidden}.back-btn{position:absolute;left:7px;top:7px;width:64px;height:56px;align-items:center;justify-content:center;}.back-icon{width:40px;height:40px}.top{position:absolute;left:88px;top:26px;width:160px;height:49px;flex-direction:column;align-items:center}.song-night,.song-day{width:160px;font-size:21px;font-weight:500;text-align:center;line-height:25px;lines:1;text-overflow:ellipsis}.song-night{color:#fff}.song-day{color:#555}.artist-night,.artist-day{width:160px;margin-top:2px;font-size:13px;text-align:center;line-height:17px;lines:1;text-overflow:ellipsis}.artist-night{color:#999}.artist-day{color:#aaa}.time-night,.time-day{position:absolute;right:26px;top:13px;width:58px;font-size:17px;font-weight:500;text-align:right;line-height:22px}.time-night{color:#eee}.time-day{color:#555}.lyrics-scroll{position:absolute;left:18px;top:92px;width:300px;height:238px}.lyrics-list{width:300px;flex-direction:column;padding-top:98px;padding-bottom:98px}.lyric-row-muted-night,.lyric-row-muted-day,.lyric-row-active-night,.lyric-row-active-day{width:300px;min-height:42px;padding-left:8px;padding-right:8px;font-size:17px;text-align:center;line-height:24px}.lyric-row-muted-night{color:#666}.lyric-row-muted-day{color:#bbb}.lyric-row-active-night{color:#fff;font-size:20px;font-weight:500}.lyric-row-active-day{color:#444;font-size:20px;font-weight:500}.empty-night,.empty-day{position:absolute;left:18px;top:180px;width:300px;font-size:18px;text-align:center;line-height:26px}.empty-night{color:#777}.empty-day{color:#aaa}.progress-row{position:absolute;left:20px;top:349px;width:296px;height:27px;align-items:center}.progress-time-night,.progress-time-day{width:43px;height:22px;font-size:14px;line-height:22px;lines:1}.progress-time-night{color:#fff}.progress-time-day{color:#555}.remaining{text-align:right}.progress-track-night,.progress-track-day{position:relative;width:209px;height:4px;margin-left:1px;border-radius:2px;background-color:#aaa}.progress-fill{height:4px;border-radius:2px;background-color:#70b6e8}.progress-knob-night,.progress-knob-day{position:absolute;top:-6px;width:16px;height:16px;border-radius:8px;border-width:2px;border-color:#fff;background-color:#70b6e8}.control-row{position:absolute;left:20px;top:388px;width:296px;height:62px;align-items:center;justify-content:space-between}.control-small{width:40px;height:52px;align-items:center;justify-content:center}.settings-icon{width:23px;height:23px}.previous-icon{width:20px;height:24px}.next-icon{width:20px;height:22px}.volume-icon{width:20px;height:20px}.control-play{width:62px;height:62px;align-items:center;justify-content:center}.play-icon{width:62px;height:62px}.detail-play-day{position:relative;width:62px;height:62px;border-radius:31px;border-width:2px;border-style:solid;border-color:#555;align-items:center;justify-content:center}.detail-play-day-triangle{width:0;height:0;margin-left:5px;border-top-width:12px;border-bottom-width:12px;border-left-width:19px;border-top-color:transparent;border-bottom-color:transparent;border-left-color:#555;border-style:solid}.detail-pause-night,.detail-pause-day{width:62px;height:62px;border-radius:31px;border-width:2px;border-style:solid;align-items:center;justify-content:center}.detail-pause-night{border-color:#fff}.detail-pause-day{border-color:#555}.detail-pause-bar-night,.detail-pause-bar-day{width:7px;height:27px;margin-left:4px;margin-right:4px;border-radius:3px}.detail-pause-bar-night{background-color:#fff}.detail-pause-bar-day{background-color:#555}.ring-lyrics-page{width:212px;height:520px;position:relative;background-color:#6f96b7;border-radius:106px;overflow:hidden}.ring-lyrics-scroll{position:absolute;left:8px;top:22px;width:196px;height:430px}.ring-lyrics-list{width:196px;flex-direction:column;padding-top:180px;padding-bottom:190px}.ring-row-muted,.ring-row-active{width:196px;min-height:46px;padding-left:8px;padding-right:8px;text-align:center;line-height:26px}.ring-row-muted{color:#b1c6d7;font-size:17px}.ring-row-active{color:#fff;font-size:20px;font-weight:500}.ring-empty{position:absolute;left:18px;top:205px;width:176px;color:#d4e0e9;font-size:18px;text-align:center;line-height:27px}.ring-back{position:absolute;left:74px;bottom:18px;width:64px;height:56px;align-items:center;justify-content:center}.ring-back-icon{width:40px;height:40px}
.lyrics-background-base{position:absolute;left:0;top:0;width:336px;height:480px}
.lyrics-background-blur{position:absolute;left:-50px;top:-72px;width:436px;height:624px}
.lyrics-background-tint{position:absolute;left:0;top:0;width:336px;height:480px;background-color:#000}
.progress-slider{position:relative;width:209px;height:16px;margin-left:1px}
.progress-track-night,.progress-track-day{position:absolute;left:0;top:6px;width:209px;height:4px;margin-left:0}
.progress-knob-night,.progress-knob-day{position:absolute;top:0;width:16px;height:16px;border-radius:8px;border-width:2px;border-color:#fff;background-color:#70b6e8}
.lyrics-scroll{top:82px;height:258px;overflow:hidden}
.ring-lyrics-scroll{overflow:hidden}
.lyrics-list{position:absolute;left:0;padding-top:0;padding-bottom:0}
.ring-lyrics-list{position:absolute;left:0;padding-top:0;padding-bottom:0}
.lyric-row-muted-night,.lyric-row-muted-day,.lyric-row-active-night,.lyric-row-active-day{height:46px;min-height:46px;line-height:23px;lines:2;text-overflow:ellipsis}
.ring-row-muted,.ring-row-active{height:46px;min-height:46px;line-height:23px;lines:2;text-overflow:ellipsis}
</style>
