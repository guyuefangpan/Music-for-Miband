<script>
import storage from "@system.storage"
import interconnect from "@system.interconnect"
import device from "@system.device"
import file from "@system.file"
import brightness from "@system.brightness"

const STORAGE_READ = "bandmediaStorageRead"
const STORAGE_READ_RESULT = "bandmediaStorageReadResult"
const STORAGE_WRITE = "bandmediaStorageWrite"
const STORAGE_WRITE_RESULT = "bandmediaStorageWriteResult"
const HANDSHAKE = "__hs__"
const HEARTBEAT = "heartbeat"
const HEARTBEAT_ACK = "heartbeatAck"
const MEDIA_STATE_KEY = "bandmedia_media_state_v1"
const LYRICS_KEY = "bandmedia_lyrics_v1"
const CONNECTION_KEY = "starry_interconnect_seen_v1"
const COVER_FILE_A = "internal://files/starry-cover-a.png"
const COVER_FILE_B = "internal://files/starry-cover-b.png"
const LEGACY_COVER_FILE_A = "internal://files/starry-cover-a.jpg"
const LEGACY_COVER_FILE_B = "internal://files/starry-cover-b.jpg"

export default {
  onCreate() {
    this.chunks = {}
    this.connected = false
    this.ready = false
    this.sessionId = ""
    this.lastMusicRequestAt = 0
    this.lastConnectionMark = 0
    this.handshakeSent = false
    this.deviceInfoSent = false
    this.deviceInfoPayload = null
    this.destroyed = false
    this.storageBusy = false
    this.pendingMediaState = null
    this.lastStoredMediaKey = ""
    this.lastMediaState = null
    this.realtimeVersion = 0
    this.lastProgressPersistAt = 0
    this.lastSyncAckAt = 0
    this.lastWatchHeartbeatAckAt = 0
    this.albumArtChunks = {}
    this.publishedArtwork = { id: "", uri: "", bytes: 0, sum: 0, format: "" }
    this.lyricsGroups = {}
    this.trackCleanupTimers = []
    // Register interconnect immediately. Cache cleanup is asynchronous and must
    // not delay Android's launch/handshake on older Vela devices.
    this.startupCleanupDone = false
    this.startCommunication()
    this.cleanupStartupCaches(() => { this.startupCleanupDone = true })
    brightness.setKeepScreenOn({ keepScreenOn: true, success: () => {}, fail: () => {}, complete: () => {} })
    console.log("app created")
  },
  cleanupStartupCaches(done) {
    this.chunks = {}
    this.albumArtChunks = {}
    this.lyricsGroups = {}
    this.lastMediaState = null
    this.pendingMediaState = null
    this.lastStoredMediaKey = ""
    this.publishedArtwork = { id: "", uri: "", bytes: 0, sum: 0, format: "" }
    for (let i = 0; i < this.trackCleanupTimers.length; i++) clearTimeout(this.trackCleanupTimers[i])
    this.trackCleanupTimers = []
    const tasks = [
      complete => storage.delete({ key: MEDIA_STATE_KEY, success: () => {}, fail: () => {}, complete: complete }),
      complete => storage.delete({ key: LYRICS_KEY, success: () => {}, fail: () => {}, complete: complete }),
      complete => storage.delete({ key: CONNECTION_KEY, success: () => {}, fail: () => {}, complete: complete }),
      complete => file.delete({ uri: COVER_FILE_A, success: () => {}, fail: () => {}, complete: complete }),
      complete => file.delete({ uri: COVER_FILE_B, success: () => {}, fail: () => {}, complete: complete }),
      complete => file.delete({ uri: LEGACY_COVER_FILE_A, success: () => {}, fail: () => {}, complete: complete }),
      complete => file.delete({ uri: LEGACY_COVER_FILE_B, success: () => {}, fail: () => {}, complete: complete })
    ]
    let remaining = tasks.length
    const complete = () => {
      remaining -= 1
      if (remaining === 0) {
        console.log("startup media cache cleared")
        done()
      }
    }
    for (let i = 0; i < tasks.length; i++) {
      try { tasks[i](complete) } catch (error) { complete() }
    }
  },
  startCommunication() {
    this.conn = interconnect.instance()
    this.conn.onmessage = messageObj => {
      if (!this.destroyed) this.handleAndroidMessage(messageObj && messageObj.data !== undefined ? messageObj.data : messageObj)
    }
    this.conn.onopen = () => {
      if (this.destroyed) return
      this.connected = true
      this.announceReady("open")
    }
    this.conn.onclose = () => {
      if (this.destroyed) return
      this.connected = false
      this.ready = false
      this.sessionId = ""
      this.handshakeSent = false
      this.deviceInfoSent = false
      this.deviceInfoPayload = null
      this.markConnected(false)
    }
    this.conn.onerror = () => {
      if (this.destroyed) return
      this.connected = false
      this.ready = false
      this.sessionId = ""
      this.handshakeSent = false
      this.deviceInfoSent = false
      this.deviceInfoPayload = null
      this.markConnected(false)
    }
    this.connectionRetryTimer = setInterval(() => {
      if (this.destroyed || this.ready) return
      this.checkConnection()
      if (this.connected) this.announceReady("retry")
    }, 1000)
    this.checkConnection()
    this.watchHeartbeatTimer = setInterval(() => {
      if (this.destroyed || !this.connected || !this.ready) return
      if (this.lastWatchHeartbeatAckAt > 0 && Date.now() - this.lastWatchHeartbeatAckAt > 15000) {
        this.markConnected(false)
        this.send({ type: "app_ready", phase: "heartbeat_timeout", timestamp: Date.now() })
      }
      this.send({ type: HEARTBEAT, origin: "watch", timestamp: Date.now() })
    }, 5000)
  },
  checkConnection() {
    if (this.destroyed || !this.conn || typeof this.conn.diagnosis !== "function") return
    try {
      this.conn.diagnosis({
        success: data => {
          if (this.destroyed) return
          const status = String(data && data.status || "").toUpperCase()
          if (status === "CONNECTED" || status === "OPEN") {
            this.connected = true
            this.announceReady("diagnosis")
          }
        },
        fail: () => {},
        complete: () => {}
      })
    } catch (error) {}
  },
  announceReady(phase) {
    if (this.destroyed || !this.connected) return
    this.send({ type: "app_ready", phase: phase, timestamp: Date.now() })
    if (this.sessionId && !this.ready) this.sendDeviceInfo()
  },
  handleAndroidMessage(data) {
    let message = data
    if (typeof data === "string") {
      try { message = JSON.parse(data) } catch (error) { return }
    }
    if (!message) return
    if (message.__c) {
      const id = String(message.id || "")
      const total = Number(message.t || 0)
      const index = Number(message.i)
      if (!id || total < 1 || total > 512 || index < 0 || index >= total) return
      let group = this.chunks[id]
      if (!group || group.total !== total) {
        group = { total: total, count: 0, parts: [], createdAt: Date.now() }
        this.chunks[id] = group
      }
      if (typeof group.parts[index] !== "string") group.count += 1
      group.parts[index] = String(message.d || "")
      if (group.count === total) {
        const joined = group.parts.join("")
        delete this.chunks[id]
        this.handleAndroidMessage(joined)
      }
      return
    }
    if (!message.type) return
    if (message.type === "album_art") { if (this.ready) this.handleAlbumArt(message); return }
    if (message.type === "artwork_probe") { if (this.ready) this.handleArtworkProbe(message); return }
    if (message.type === HANDSHAKE) {
      this.connected = true
      const session = String(message.session || "")
      if (session && session !== this.sessionId) {
        this.sessionId = session
        this.ready = false
        this.deviceInfoSent = false
        this.deviceInfoPayload = null
      }
      const count = Number(message.count)
      if (count >= 0 && count < 2) this.sendHandshake(count + 1)
      if (this.sessionId) {
        this.send({ type: "app_ready", phase: "handshake", sequence: 1, session: this.sessionId, timestamp: Date.now() })
        this.send({ type: "app_ready", phase: "handshake", sequence: 2, session: this.sessionId, timestamp: Date.now() })
        this.sendDeviceInfo()
      }
    } else if (message.type === "device_info_ack") {
      if (!this.sessionId || String(message.session || "") !== this.sessionId) return
      this.ready = true
      this.lastWatchHeartbeatAckAt = Date.now()
      this.markConnected(true)
      this.requestMusicOnce()
    } else if (message.type === HEARTBEAT) {
      if (!this.ready) return
      this.markConnected(true)
      this.send({ type: HEARTBEAT_ACK, timestamp: Date.now() })
    } else if (message.type === HEARTBEAT_ACK) {
      if (!this.ready) return
      this.lastWatchHeartbeatAckAt = Date.now()
      this.markConnected(true)
    } else if (message.type === "music_info") {
      if (!this.ready) return
      const previous = this.lastMediaState
      const state = this.safeMediaState(message)
      if (previous && previous.mediaKey && previous.mediaKey !== state.mediaKey) this.schedulePreviousTrackCleanup(previous, state.mediaKey, Date.now())
      this.lastMediaState = state
      this.publishRealtimeState()
      this.persistMediaState(state)
      this.markConnected(true)
    } else if (message.type === "media_progress") {
      if (!this.ready) return
      this.applyProgress(message)
      this.markConnected(true)
    } else if (message.type === "lyrics_batch") {
      if (!this.ready || !this.lastMediaState) return
      const id = String(message.id || "")
      const total = Number(message.t || 0)
      const index = Number(message.i)
      if (!id || id !== this.lastMediaState.lyricsId || total < 1 || total > 128 || index < 0 || index >= total) return
      let group = this.lyricsGroups[id]
      if (!group || group.total !== total) { group = { total: total, count: 0, parts: [] }; this.lyricsGroups[id] = group }
      if (!group.parts[index]) group.count += 1
      group.parts[index] = Array.isArray(message.lines) ? message.lines : []
      if (group.count !== total) return
      const lines = []
      for (let partIndex = 0; partIndex < group.parts.length && lines.length < 500; partIndex++) {
        const part = group.parts[partIndex] || []
        for (let lineIndex = 0; lineIndex < part.length && lines.length < 500; lineIndex++) {
          const line = part[lineIndex]
          if (line && String(line.text || "").trim()) lines.push({ startMs: Number(line.startMs) || 0, text: String(line.text || "").slice(0, 500) })
        }
      }
      delete this.lyricsGroups[id]
      this.lastMediaState.lyrics = lines
      this.publishRealtimeState()
      this.persistLyrics(id, lines)
      this.send({ type: "lyrics_ack", id: id, lines: lines.length, ok: true })
    } else if (message.type === "music_clear") {
      if (!this.ready) return
      storage.set({ key: MEDIA_STATE_KEY, value: JSON.stringify({ version: 1, title: "", artist: "", playbackState: "stopped", updatedAt: Date.now() }), success: () => {}, fail: () => {}, complete: () => {} })
      storage.set({ key: LYRICS_KEY, value: JSON.stringify({ id: "", lines: [] }), success: () => {}, fail: () => {}, complete: () => {} })
      this.lastMediaState = null
      this.markConnected(true)
    } else if (message.type === "clear_media_cache") {
      if (!this.ready) return
      this.clearAllMediaCaches(() => {
        this.send({ type: "cache_clear_ack", reason: String(message.reason || ""), id: String(message.id || "") })
      })
    } else if (message.type === STORAGE_READ) {
      if (!this.ready) return
      storage.get({ key: message.key, success: value => this.send({ type: STORAGE_READ_RESULT, key: message.key, value: typeof value === "string" ? value : JSON.stringify(value || {}), requestId: message.requestId }), fail: () => this.send({ type: STORAGE_READ_RESULT, key: message.key, value: "", requestId: message.requestId, error: true }), complete: () => {} })
    } else if (message.type === STORAGE_WRITE) {
      if (!this.ready) return
      storage.set({ key: message.key, value: message.value, success: () => this.send({ type: STORAGE_WRITE_RESULT, key: message.key, requestId: message.requestId, ok: true }), fail: () => this.send({ type: STORAGE_WRITE_RESULT, key: message.key, requestId: message.requestId, ok: false }), complete: () => {} })
    }
  },
  applyProgress(message) {
    if (!this.lastMediaState) return
    this.lastMediaState.positionMs = Number(message.positionMs) || 0
    this.lastMediaState.durationMs = Number(message.durationMs) || this.lastMediaState.durationMs || 0
    this.lastMediaState.playbackState = String(message.playbackState || this.lastMediaState.playbackState || "stopped")
    this.lastMediaState.activeLyricIndex = isNaN(Number(message.activeLyricIndex)) ? -1 : Number(message.activeLyricIndex)
    const activeLine = this.lastMediaState.lyrics[this.lastMediaState.activeLyricIndex]
    this.lastMediaState.activeLyric = activeLine ? String(activeLine.text || "") : ""
    this.lastMediaState.volume = Number(message.volume) || 0
    this.lastMediaState.muted = message.muted === true
    this.lastMediaState.updatedAt = Date.now()
    this.publishRealtimeState()
    const now = Date.now()
    if (now - this.lastSyncAckAt >= 1000 && Number(message.sentAt) > 0) {
      this.lastSyncAckAt = now
      this.send({ type: "sync_ack", sequence: Number(message.sequence) || 0, sentAt: Number(message.sentAt), appliedAt: now })
    }
    if (now - this.lastProgressPersistAt >= 1000) {
      this.lastProgressPersistAt = now
      this.persistMediaState(this.lastMediaState)
    }
  },
  applyLyricWindow(message) {
    const source = Array.isArray(message.lyricWindow) ? message.lyricWindow : []
    const lines = []
    for (let i = 0; i < source.length && i < 7; i++) {
      const line = source[i]
      if (line && String(line.text || "").trim()) lines.push({ startMs: Number(line.startMs) || 0, text: String(line.text || "").slice(0, 240), sourceIndex: Number(line.sourceIndex) || 0 })
    }
    this.lastMediaState.lyricWindow = lines
    const active = Number(message.lyricWindowActiveIndex)
    this.lastMediaState.lyricWindowActiveIndex = isNaN(active) ? -1 : active
  },
  publishRealtimeState() {
    this.realtimeVersion += 1
  },
  getRealtimeMediaState() {
    return { state: this.lastMediaState, connected: this.connected, version: this.realtimeVersion }
  },
  handleArtworkProbe(message) {
    const requestId = String(message.requestId || "")
    const id = String(message.id || "")
    const expectedBytes = Number(message.bytes || 0)
    const expectedSum = Number(message.sum || 0)
    const format = String(message.format || "")
    if (!requestId || !id || (format !== "jpg" && format !== "png") || expectedBytes < 1) return
    const published = this.publishedArtwork || {}
    const currentUri = this.lastMediaState ? String(this.lastMediaState.albumArt || "") : ""
    const publishedUri = String(published.uri || "")
    const suffix = format === "jpg" ? ".jpg" : ".png"
    const cached = String(published.id || "") === id && publishedUri.slice(-4) === suffix && Number(published.bytes || 0) === expectedBytes && Number(published.sum || 0) === expectedSum && String(published.format || "") === format
    if (cached) {
      if (this.lastMediaState && currentUri !== publishedUri) {
        this.lastMediaState.albumArt = publishedUri
        this.persistMediaState(this.lastMediaState)
        this.publishRealtimeState()
      }
      this.send({ type: "artwork_probe_result", requestId: requestId, id: id, cached: true, cleared: false, format: format, bytes: expectedBytes, sum: expectedSum, uri: publishedUri })
      return
    }
    // A cache miss must not destroy the currently displayed cover. The new image
    // is written to a unique URI and replaces this one only after validation.
    this.albumArtChunks = {}
    this.send({ type: "artwork_probe_result", requestId: requestId, id: id, cached: false, retained: true, format: format, bytes: expectedBytes, sum: expectedSum })
  },
  handleAlbumArt(message) {
    const id = String(message.id || "")
    const transferId = String(message.tx || "")
    const total = Number(message.t || 0)
    const index = Number(message.i)
    const expectedChars = Number(message.chars || 0)
    const expectedBytes = Number(message.bytes || 0)
    const expectedSum = Number(message.sum || 0)
    const format = String(message.format || "")
    if (!id || !transferId || (format !== "jpg" && format !== "png") || total < 1 || total > 3 || index < 0 || index >= total || expectedChars < 1 || expectedBytes < 1) return
    if (!this.lastMediaState || this.lastMediaState.artworkId !== id) return
    const groupKey = id + "|" + transferId
    let group = this.albumArtChunks[groupKey]
    if (!group || group.total !== total || group.chars !== expectedChars || group.bytes !== expectedBytes || group.sum !== expectedSum) {
      for (const key in this.albumArtChunks) { if (key.indexOf(id + "|") === 0) delete this.albumArtChunks[key] }
      group = { total: total, count: 0, parts: [], chars: expectedChars, bytes: expectedBytes, sum: expectedSum }
      this.albumArtChunks[groupKey] = group
    }
    if (typeof group.parts[index] !== "string") group.count += 1
    group.parts[index] = String(message.d || "")
    if (group.count !== total) return
    delete this.albumArtChunks[groupKey]
    const dataUri = group.parts.join("")
    if (dataUri.length !== expectedChars) { this.send({ type: "asset_ack", asset: "artwork", id: id, tx: transferId, ok: false, code: "length_mismatch" }); return }
    const encoded = dataUri.indexOf(",") >= 0 ? dataUri.slice(dataUri.indexOf(",") + 1) : dataUri
    if (!encoded) { this.lastMediaState.albumArt = ""; this.persistMediaState(this.lastMediaState); return }
    try {
      const bytes = this.decodeBase64(encoded)
      if (!bytes || !bytes.length) { this.send({ type: "asset_ack", asset: "artwork", id: id, tx: transferId, ok: false, code: "decode_empty" }); return }
      if (bytes.length !== expectedBytes) { this.send({ type: "asset_ack", asset: "artwork", id: id, tx: transferId, ok: false, code: "byte_length_mismatch" }); return }
      if (this.adler32(bytes) !== expectedSum) { this.send({ type: "asset_ack", asset: "artwork", id: id, tx: transferId, ok: false, code: "checksum_mismatch" }); return }
      const validStructure = format === "jpg" ? this.validateJpegStructure(bytes) : this.validatePngStructure(bytes)
      if (!validStructure) { this.send({ type: "asset_ack", asset: "artwork", id: id, tx: transferId, ok: false, code: "invalid_" + format + "_structure" }); return }
      const safeTransferId = transferId.replace(/[^0-9A-Za-z_-]/g, "").slice(0, 64)
      if (!safeTransferId) { this.send({ type: "asset_ack", asset: "artwork", id: id, tx: transferId, ok: false, code: "invalid_transfer_id" }); return }
      // A unique URI prevents the Vela image decoder from serving pixels cached for an older transfer.
      const coverFile = "internal://files/starry-cover-" + safeTransferId + (format === "jpg" ? ".jpg" : ".png")
      file.writeArrayBuffer({
        uri: coverFile,
        // Vela file.writeArrayBuffer requires Uint8Array, not ArrayBuffer.
        buffer: bytes,
        append: false,
        success: () => {
          if (this.destroyed || !this.lastMediaState || this.lastMediaState.artworkId !== id) {
            file.delete({ uri: coverFile, success: () => {}, fail: () => {}, complete: () => {} })
            this.send({ type: "asset_ack", asset: "artwork", id: id, tx: transferId, ok: false, code: "stale_track" })
            return
          }
          const previousCover = String((this.publishedArtwork || {}).uri || this.lastMediaState.albumArt || "")
          this.lastMediaState.albumArt = coverFile
          this.publishedArtwork = { id: id, uri: coverFile, bytes: bytes.length, sum: expectedSum, format: format }
          this.publishRealtimeState()
          this.persistMediaState(this.lastMediaState)
          setTimeout(() => {
            if (this.destroyed || !this.lastMediaState || this.lastMediaState.artworkId !== id || this.lastMediaState.albumArt !== coverFile) {
              this.send({ type: "asset_ack", asset: "artwork", id: id, tx: transferId, ok: false, code: "publish_replaced" })
              return
            }
            this.send({ type: "asset_ack", asset: "artwork", id: id, tx: transferId, ok: true, bytes: bytes.length, sum: expectedSum, format: format, verified: format === "jpg" ? "jpeg_structure_v1" : "png_structure_v1", uri: coverFile })
            if (previousCover && previousCover !== coverFile) {
              setTimeout(() => {
                if (!this.destroyed && (!this.lastMediaState || this.lastMediaState.albumArt !== previousCover)) file.delete({ uri: previousCover, success: () => {}, fail: () => {}, complete: () => {} })
              }, 5000)
            }
          }, 200)
        },
        fail: (error, code) => { console.log("cover write failed code=" + String(code || "") + " " + JSON.stringify(error || {})); this.send({ type: "asset_ack", asset: "artwork", id: id, tx: transferId, ok: false, code: "write_" + String(code || "failed") }) },
        complete: () => {}
      })
    } catch (error) { console.log("cover processing failed " + String(error)); this.send({ type: "asset_ack", asset: "artwork", id: id, tx: transferId, ok: false, code: "processing_exception" }) }
  },
  adler32(bytes) {
    let a = 1
    let b = 0
    for (let i = 0; i < bytes.length; i++) { a = (a + bytes[i]) % 65521; b = (b + a) % 65521 }
    return b * 65536 + a
  },
  validateJpegStructure(bytes) {
    return !!bytes && bytes.length >= 4 && bytes[0] === 255 && bytes[1] === 216 && bytes[bytes.length - 2] === 255 && bytes[bytes.length - 1] === 217
  },
  validatePngStructure(bytes) {
    if (!bytes || bytes.length < 45 || bytes[0] !== 137 || bytes[1] !== 80 || bytes[2] !== 78 || bytes[3] !== 71 || bytes[4] !== 13 || bytes[5] !== 10 || bytes[6] !== 26 || bytes[7] !== 10) return false
    let offset = 8
    let chunkIndex = 0
    let hasIdat = false
    while (offset + 12 <= bytes.length) {
      const length = bytes[offset] * 16777216 + bytes[offset + 1] * 65536 + bytes[offset + 2] * 256 + bytes[offset + 3]
      if (length < 0 || offset + 12 + length > bytes.length) return false
      const type = String.fromCharCode(bytes[offset + 4], bytes[offset + 5], bytes[offset + 6], bytes[offset + 7])
      if (chunkIndex === 0) {
        if (type !== "IHDR" || length !== 13) return false
        const width = bytes[offset + 8] * 16777216 + bytes[offset + 9] * 65536 + bytes[offset + 10] * 256 + bytes[offset + 11]
        const height = bytes[offset + 12] * 16777216 + bytes[offset + 13] * 65536 + bytes[offset + 14] * 256 + bytes[offset + 15]
        if (width < 1 || height < 1 || width > 2048 || height > 2048) return false
      }
      if (type === "IDAT") hasIdat = true
      offset += length + 12
      chunkIndex += 1
      if (type === "IEND") return length === 0 && hasIdat && offset === bytes.length
      if (chunkIndex > 2048) return false
    }
    return false
  },
  schedulePreviousTrackCleanup(previous, currentMediaKey, switchedAt) {
    const oldMediaKey = String(previous.mediaKey || "")
    const oldArtworkId = String(previous.artworkId || "")
    const oldLyricsId = String(previous.lyricsId || "")
    const timer = setTimeout(() => {
      this.trackCleanupTimers = this.trackCleanupTimers.filter(item => item !== timer)
      if (this.destroyed) return
      for (const chunkId in this.chunks) {
        const group = this.chunks[chunkId]
        if (group && Number(group.createdAt || 0) <= switchedAt) delete this.chunks[chunkId]
      }
      if (oldArtworkId) { for (const key in this.albumArtChunks) { if (key.indexOf(oldArtworkId + "|") === 0) delete this.albumArtChunks[key] } }
      if (oldLyricsId) delete this.lyricsGroups[oldLyricsId]
      // Artwork files are retired only after a replacement image has been fully
      // written, published and acknowledged. A track timer must not delete them.
      this.deleteStoredTrackIfMatching(MEDIA_STATE_KEY, "mediaKey", oldMediaKey)
      this.deleteStoredTrackIfMatching(LYRICS_KEY, "id", oldLyricsId)
      console.log("previous track cache cleared old=" + oldMediaKey + " current=" + currentMediaKey)
    }, 5000)
    this.trackCleanupTimers.push(timer)
  },
  deleteStoredTrackIfMatching(key, field, expected) {
    if (!expected) return
    storage.get({
      key: key,
      success: value => {
        if (this.destroyed) return
        try {
          const parsed = typeof value === "string" ? JSON.parse(value) : (value || {})
          if (String(parsed[field] || "") === expected) {
            storage.delete({ key: key, success: () => {}, fail: () => {}, complete: () => {} })
          }
        } catch (error) {}
      },
      fail: () => {},
      complete: () => {}
    })
  },
  clearAllMediaCaches(done) {
    const activeCover = this.lastMediaState ? String(this.lastMediaState.albumArt || "") : String((this.publishedArtwork || {}).uri || "")
    this.chunks = {}
    this.albumArtChunks = {}
    this.lyricsGroups = {}
    this.lastMediaState = null
    this.publishedArtwork = { id: "", uri: "", bytes: 0, sum: 0, format: "" }
    this.pendingMediaState = null
    this.lastStoredMediaKey = ""
    this.publishRealtimeState()
    const tasks = [
      complete => storage.delete({ key: MEDIA_STATE_KEY, success: () => {}, fail: () => {}, complete: complete }),
      complete => storage.delete({ key: LYRICS_KEY, success: () => {}, fail: () => {}, complete: complete }),
      complete => file.delete({ uri: COVER_FILE_A, success: () => {}, fail: () => {}, complete: complete }),
      complete => file.delete({ uri: COVER_FILE_B, success: () => {}, fail: () => {}, complete: complete }),
      complete => file.delete({ uri: LEGACY_COVER_FILE_A, success: () => {}, fail: () => {}, complete: complete }),
      complete => file.delete({ uri: LEGACY_COVER_FILE_B, success: () => {}, fail: () => {}, complete: complete })
    ]
    if (activeCover && activeCover !== COVER_FILE_A && activeCover !== COVER_FILE_B && activeCover !== LEGACY_COVER_FILE_A && activeCover !== LEGACY_COVER_FILE_B) {
      tasks.push(complete => file.delete({ uri: activeCover, success: () => {}, fail: () => {}, complete: complete }))
    }
    let remaining = tasks.length
    const complete = () => { remaining -= 1; if (remaining === 0 && done) done() }
    for (let i = 0; i < tasks.length; i++) {
      try { tasks[i](complete) } catch (error) { complete() }
    }
  },
  decodeBase64(value) {
    const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    const clean = String(value || "").replace(/[^A-Za-z0-9+/=]/g, "")
    if (!clean) return new Uint8Array(0)
    let padding = 0
    if (clean.charAt(clean.length - 1) === "=") padding += 1
    if (clean.charAt(clean.length - 2) === "=") padding += 1
    const output = new Uint8Array(Math.floor(clean.length * 3 / 4) - padding)
    let outputIndex = 0
    for (let i = 0; i < clean.length; i += 4) {
      const a = alphabet.indexOf(clean.charAt(i)); const b = alphabet.indexOf(clean.charAt(i + 1))
      const c = clean.charAt(i + 2) === "=" ? 0 : alphabet.indexOf(clean.charAt(i + 2))
      const d = clean.charAt(i + 3) === "=" ? 0 : alphabet.indexOf(clean.charAt(i + 3))
      if (a < 0 || b < 0 || c < 0 || d < 0) throw new Error("invalid base64")
      const bits = (a << 18) | (b << 12) | (c << 6) | d
      if (outputIndex < output.length) output[outputIndex++] = (bits >> 16) & 255
      if (outputIndex < output.length) output[outputIndex++] = (bits >> 8) & 255
      if (outputIndex < output.length) output[outputIndex++] = bits & 255
    }
    return output
  },
  send(message) {
    if (this.destroyed || !this.connected || !this.conn || !message) return
    try {
      this.conn.send({ data: message, success: () => {}, fail: () => { this.connected = false; this.markConnected(false) }, complete: () => {} })
    } catch (error) {
      this.connected = false
      this.markConnected(false)
    }
  },
  sendHandshake(count) {
    if (this.handshakeSent && count === 0) return
    this.handshakeSent = true
    this.send({ type: HANDSHAKE, count: count, version: 1, session: this.sessionId })
  },
  sendDeviceInfoOnce() {
    this.sendDeviceInfo()
  },
  sendDeviceInfo() {
    if (this.destroyed || !this.sessionId) return
    if (this.deviceInfoPayload) {
      this.send(this.deviceInfoPayload)
      return
    }
    if (this.deviceInfoSent) return
    this.deviceInfoSent = true
    device.getInfo({
      success: info => {
        if (this.destroyed) return
        const data = info || {}
        const width = Number(data.screenWidth || data.width || 0)
        const height = Number(data.screenHeight || data.height || 0)
        const artworkFormat = "png"
        this.deviceInfoPayload = { type: "device_info", session: this.sessionId, protocolVersion: 2, artworkFormat: artworkFormat, product: data.product || data.brand || data.manufacturer || "", model: data.model || "", screenWidth: width, screenHeight: height, screenShape: data.screenShape || "" }
        this.send(this.deviceInfoPayload)
      },
      fail: () => {
        if (!this.destroyed) {
          this.deviceInfoPayload = { type: "device_info", session: this.sessionId, protocolVersion: 2, artworkFormat: "png", product: "", model: "", screenWidth: 0, screenHeight: 0, screenShape: "" }
          this.send(this.deviceInfoPayload)
        }
      },
      complete: () => {}
    })
  },
  requestMusicOnce() {
    const now = Date.now()
    if (now - this.lastMusicRequestAt < 3000) return
    this.lastMusicRequestAt = now
    this.send({ type: "get_music" })
  },
  persistMediaState(state) {
    if (this.destroyed) return
    const key = [state.title, state.artist, state.album, state.albumArt || "", state.playbackState, state.durationMs, Number(state.positionMs) || 0, state.activeLyricIndex, state.volume, state.muted].join("|")
    this.pendingMediaState = state
    if (this.storageBusy) return
    if (key === this.lastStoredMediaKey) return
    this.storageBusy = true
    this.lastStoredMediaKey = key
    const summary = {}
    for (const field in state) { if (field !== "lyrics") summary[field] = state[field] }
    const value = JSON.stringify(summary)
    storage.set({ key: MEDIA_STATE_KEY, value: value, success: () => { this.storageBusy = false; this.flushMediaState() }, fail: () => { this.storageBusy = false; this.flushMediaState() }, complete: () => {} })
  },
  persistLyrics(id, lines) {
    storage.set({ key: LYRICS_KEY, value: JSON.stringify({ id: id, lines: lines }), success: () => {}, fail: error => { console.log("lyrics storage failed " + JSON.stringify(error || {})) }, complete: () => {} })
  },
  flushMediaState() {
    if (this.pendingMediaState) {
      const next = this.pendingMediaState
      this.pendingMediaState = null
      this.persistMediaState(next)
    }
  },
  safeMediaState(message) {
    const previous = this.lastMediaState
    const state = {
      version: 1,
      type: "music_info",
      mediaKey: String(message.mediaKey || [message.sourcePackage || "", message.title || "", message.artist || "", message.album || ""].join("|")),
      title: String(message.title || "").slice(0, 160),
      artist: String(message.artist || "").slice(0, 160),
      album: String(message.album || "").slice(0, 160),
      playbackState: String(message.playbackState || (Number(message.state) === 1 ? "playing" : "paused")),
      positionMs: Number(message.positionMs) || 0,
      durationMs: Number(message.durationMs) || 0,
      volume: Number(message.volume) || 0,
      muted: message.muted === true,
      activeLyricIndex: isNaN(Number(message.activeLyricIndex)) ? -1 : Number(message.activeLyricIndex),
      activeLyric: String(message.activeLyric || "").slice(0, 500),
      lyricWindow: [],
      lyricWindowActiveIndex: -1,
      sourcePackage: String(message.sourcePackage || "").slice(0, 160),
      sourceName: String(message.sourceName || "").slice(0, 160),
      updatedAt: Date.now(),
      lyrics: []
    }
    state.artworkId = String(message.artworkId || "")
    state.lyricsId = String(message.lyricsId || "")
    if (state.artworkId && previous && previous.mediaKey === state.mediaKey && previous.artworkId === state.artworkId) {
      state.albumArt = previous.albumArt || ""
    }
    if (state.artworkId && !state.albumArt && this.publishedArtwork && this.publishedArtwork.uri) {
      // Keep the last verified cover visible until this track's replacement
      // has been fully written, validated and acknowledged.
      state.albumArt = String(this.publishedArtwork.uri || "")
    }
    if (state.lyricsId && previous && previous.mediaKey === state.mediaKey && previous.lyricsId === state.lyricsId) {
      state.lyrics = previous.lyrics || []
    }
    if (!state.artworkId) state.albumArt = ""
    if (!state.lyricsId) state.lyrics = []
    if (!previous || previous.mediaKey !== state.mediaKey) {
      this.albumArtChunks = {}
      this.lyricsGroups = {}
      this.persistLyrics(state.lyricsId, [])
    }
    this.lastMediaState = state
    this.applyLyricWindow(message)
    return state
  },
  markConnected(connected) {
    const now = Date.now()
    if (connected && now - this.lastConnectionMark < 3000) return
    this.lastConnectionMark = now
    storage.set({ key: CONNECTION_KEY, value: connected ? String(now) : "0", success: () => {}, fail: () => {}, complete: () => {} })
  },
  onDestroy() {
    this.destroyed = true
    this.connected = false
    this.ready = false
    this.sessionId = ""
    this.handshakeSent = false
    this.deviceInfoSent = false
    this.deviceInfoPayload = null
    this.chunks = {}
    this.albumArtChunks = {}
    this.lyricsGroups = {}
    this.pendingMediaState = null
    if (this.conn) {
      this.conn.onmessage = null
      this.conn.onopen = null
      this.conn.onclose = null
      this.conn.onerror = null
    }
    this.conn = null
    if (this.watchHeartbeatTimer) clearInterval(this.watchHeartbeatTimer)
    if (this.connectionRetryTimer) clearInterval(this.connectionRetryTimer)
    for (let i = 0; i < this.trackCleanupTimers.length; i++) clearTimeout(this.trackCleanupTimers[i])
    this.trackCleanupTimers = []
    brightness.setKeepScreenOn({ keepScreenOn: false, success: () => {}, fail: () => {}, complete: () => {} })
    console.log("app destroyed")
  }
}
</script>
